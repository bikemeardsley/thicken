# Everything text is LF in the repo and in the working tree, on every OS.
* text=auto eol=lf

# Pictures and models are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.heic binary
*.pdf binary
*.glb binary
*.ttf binary
*.webp binary

# The plugin's files exactly as committed, on every checkout: the Claude plugin directory refuses a plugin whose
# files git would rewrite on the way out (line endings included).
plugin/** !text !eol
