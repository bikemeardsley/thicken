{
  "name": "thicken",
  "version": "0.1.0",
  "description": "Flat images in, 3D assets (GLB) out: photos of books, graded slabs, cards, badges and boxes made into models at their real size.",
  "license": "MIT",
  "author": "Michael Beardsley (https://github.com/bikemeardsley)",
  "repository": "github:bikemeardsley/thicken",
  "keywords": ["3d", "glb", "gltf", "photos", "books", "trading-cards", "graded-cards", "slab", "badge", "lettering", "vision"],
  "type": "module",
  "bin": {
    "thicken": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/thicken.d.ts",
      "default": "./dist/thicken.js"
    }
  },
  "files": ["dist", "fonts"],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts test/profiles/*.test.ts",
    "check": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "readme": "node scripts/readme.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@google/model-viewer": "4.3.1",
    "earcut": "3.2.4",
    "exif-reader": "2.0.3",
    "libheif-js": "1.23.2",
    "opentype.js": "2.0.0",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "unpdf": "1.8.1",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
