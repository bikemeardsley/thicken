{
  "name": "thicken",
  "version": "0.1.0",
  "description": "Photos in; out comes a 3D model (GLB) at the object's real size and its metadata as JSON. A profile for each kind of object; add your own.",
  "license": "MIT",
  "author": "Michael Beardsley (https://github.com/bikemeardsley)",
  "repository": { "type": "git", "url": "git+https://github.com/bikemeardsley/thicken.git" },
  "mcpName": "io.github.bikemeardsley/thicken",
  "keywords": ["3d", "glb", "gltf", "photos", "books", "trading-cards", "graded-cards", "slab", "badge", "lettering", "vision", "mcp"],
  "type": "module",
  "bin": {
    "thicken": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/thicken.d.ts",
      "default": "./dist/thicken.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    }
  },
  "files": ["dist", "fonts", "templates", "src/profiles"],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --env-file=test/test.env --test test/*.test.ts test/profiles/*.test.ts",
    "check": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "readme": "node scripts/readme.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@google/model-viewer": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "earcut": "3.2.4",
    "exif-reader": "2.0.3",
    "libheif-js": "1.23.2",
    "opentype.js": "2.0.0",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "unpdf": "1.8.1",
    "zod": "4.6.5",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
